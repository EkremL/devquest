      "anchor": "diagnose-the-response",
      "title": "Diagnose before retrying",
      "objectives": [
        "classify-http-outcomes"
      ],
      "observations": [
        {
          "request": "GET /reports/42 · no credentials",
          "status": "401",
          "challenge": "Bearer realm=\"reports\""
        },
        {
          "request": "GET /reports/42 · accepted token without report:read",
          "status": "403",
          "challenge": "Bearer error=\"insufficient_scope\""
        },
        {
          "request": "GET /reports/42 · accepted token with report:read",
          "status": "200"
        }
      ],
      "practice": {
        "presentation": "diagnosis",
        "prompt": "An Android app omits its token and receives the first listed response. It then sends a recognized token and receives the second. Which fact changed, and what should the engineer investigate now?",
        "choices": [
          {
            "label": "The API now accepts the credential. Investigate the missing report permission.",
            "reason": "The documented trace moves from missing evidence to accepted evidence followed by a permission denial. Repeating the same token does not change that permission."
          },
          {
            "label": "The API still lacks usable credentials. Inspect only the header-writing code.",
            "reason": "The second trace states that validation already succeeded. Inspecting header construction alone misses the policy decision."
          },
          {
            "label": "The API has limited the request rate. Wait and resend the same token.",
            "reason": "The reported response is a scope denial. Use the rate-limit policy when evidence identifies a 429 instead."
          }
        ]
      }
    }
  ],
